DISCORD_TOKEN=bot_token
GUILD_ID=server_id
# Main administrator (always able to sign in, cannot be deleted or suspended from the web)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use_a_long_password_of_20_or_more_characters
# Random text used to sign login sessions (optional locally, generated automatically on Render)
# SESSION_SECRET=
# MongoDB Atlas (free). Without it a local file is used, which Render Free wipes on every restart.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=iberia_publisher
# Optional AI keys (they can also be saved in the web panel): GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY
# GEMINI_API_KEY=
